# ---------------------------------------------------------------------------
# LegacyByConsumer — frontend environment
# Copy to .env.local for development. Never commit a filled-in copy.
# ---------------------------------------------------------------------------

# Base URL of the Laravel API. Server-side only — never exposed to the browser.
API_URL=http://127.0.0.1:8000

# Shared secret the Laravel API checks on every form submission.
# Generate with: php artisan legacy:api-key
# Server-side only — never prefix this with NEXT_PUBLIC_.
API_KEY=replace-with-the-key-printed-by-the-artisan-command
